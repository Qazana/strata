---
// Embeds a live library demo as an iframe. The demos are synced into public/demo
// by scripts/sync-assets.mjs and resolve their own relative CSS/JS, so what you
// see here is the real component, not a screenshot. `src` is a path under demo/,
// e.g. "app/components.html" or "app/components.html#buttons".
interface Props {
  src: string;
  title?: string;
  height?: number;
}
const { src, title = 'Live demo', height = 540 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${base}/demo/${src}`;
---
<figure class="qz-demo">
  <iframe
    src={url}
    title={title}
    loading="lazy"
    style={`width:100%;height:${height}px;border:1px solid var(--sl-color-gray-5);border-radius:.5rem;background:#0a0a0a`}
  ></iframe>
  <figcaption style="margin-top:.4rem;font-size:.85rem">
    <a href={url} target="_blank" rel="noopener">Open “{title}” in a new tab ↗</a>
  </figcaption>
</figure>
