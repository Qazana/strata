{
  "name": "@qazana/strata",
  "version": "0.0.2",
  "description": "Qazana Strata — the shared, framework-agnostic design system — semantic design tokens + vanilla (data-attribute) component CSS/JS, themeable per product with a single :root override.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qazana/strata.git"
  },
  "homepage": "https://strata.docs.qazana.net/",
  "bugs": "https://github.com/Qazana/strata/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "js/qazana.js",
  "style": "kits/app.css",
  "exports": {
    ".": {
      "import": "./js/qazana.js",
      "default": "./js/qazana.js"
    },
    "./app": "./kits/app.css",
    "./site": "./kits/site.css",
    "./content": "./kits/content.css",
    "./auth": "./kits/auth.css",
    "./media": "./kits/media.css",
    "./email/*": "./kits/email/*",
    "./tokens": "./tokens/qazana.tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./commerce": "./kits/commerce.css",
    "./js": "./js/qazana.js"
  },
  "files": [
    "tokens",
    "kits",
    "js",
    "fonts",
    "HANDOFF.md"
  ],
  "scripts": {
    "demo": "python3 -m http.server 4178 --bind 127.0.0.1",
    "harness": "node harness/shoot.mjs",
    "harness:behaviors": "node harness/behaviors.mjs",
    "test": "node harness/behaviors.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "playwright": "^1.60.0"
  }
}
